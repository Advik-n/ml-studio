# ──────────────────────────────────────────────────────────────────────
# Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────
# LOCAL:       Copy to .env
# RENDER:      Set in Dashboard → Environment
# HF SPACES:   Set in Settings → Secrets
# ──────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────
# Local:    sqlite:///./ml_studio.db
# Supabase: postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./ml_studio.db

# ── Auth ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Prod:  https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:8000

# ── File Uploads ──────────────────────────────────────────────────────
# UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# ── SMTP (optional) ──────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
